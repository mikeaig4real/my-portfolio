# ── App & Server Configuration ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PROJECT_NAME="my-portfolio"
NEXT_PUBLIC_PROJECT_NAME="my-portfolio"
FRONTEND_URL=http://localhost:3000

# ── Database Layer Configuration ───────────────────────────────────────────
# Providers: 'drizzle' (Drizzle ORM SQLite), 'sqlite' (JSON File DB), or 'mongodb'
DATABASE_PROVIDER=drizzle
SQLITE_DB_PATH=.storage/portfolio.db
MONGODB_URI=mongodb://127.0.0.1:27017/my_portfolio_db

# ── AI Inference & Automated Onboarding Configuration ──────────────────────
# Providers: 'openrouter', 'openai', or 'ollama'
INFERENCE_PROVIDER=openrouter
INFERENCE_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Stealth Admin & Security Credentials ─────────────────────────────────────
ADMIN_PASSWORD=AdminPassword123!
ADMIN_SESSION_TOKEN_VALUE=authenticated_admin
NEXT_PUBLIC_ADMIN_UNLOCK_KEY=p
NEXT_PUBLIC_ADMIN_SESSION_COOKIE_NAME=my_portfolio_admin_session
ADMIN_SESSION_COOKIE_NAME=my_portfolio_admin_session

# ── Cloudinary Asset & Image Uploads (Optional - local base64 fallback used if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Auth, JWT & Session Secrets ───────────────────────────────────────────────
SECRET_KEY=replace_with_a_secure_random_64_char_hex_string
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key
REFRESH_TOKEN_COOKIE_NAME=my_portfolio_refresh_token
